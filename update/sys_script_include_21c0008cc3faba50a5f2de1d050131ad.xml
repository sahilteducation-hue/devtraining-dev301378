        <name>IncidentListUtil</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var IncidentListUtil = Class.create();
IncidentListUtil.prototype = {
    initialize: function () {},

    getInProgressIncidents: function (maxCount) {
        maxCount = parseInt(maxCount, 10) || 10;

        var results = [];
        var gr = new GlideRecord('incident');
        gr.addQuery('state', 2); // 2 = In Progress (typical OOB)
        gr.orderByDesc('sys_updated_on');
        gr.setLimit(maxCount);
        gr.query();

        while (gr.next()) {
            results.push({
                number: gr.getValue('number'),
                short_description: gr.getValue('short_description')
            });
        }
        return results;
    },

    type: 'IncidentListUtil'
};]]></script>
