        <name>IncidentsForUser</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[// Display a greeting with the current user's name
var userName = "$[gs.getUserName()]";
document.getElementById('greeting').innerText = "Hello, " + userName + "! Here are your recent incidents:";
 
// Use GlideAjax to get recent incidents for the user
var ga = new GlideAjax('IncidentsForUser');
ga.addParam('sysparm_name', 'getRecentIncidents');
ga.getXMLAnswer(function(response){
    var incidents = [];
    try {
        incidents = JSON.parse(response);
    } catch (e) {
        incidents = [];
    }
    var table = '<table border="1" style="width:100%;border-collapse:collapse;"><thead><tr><th>Number</th><th>Short Description</th><th>State</th><th>Last Updated</th></tr></thead><tbody>';
    incidents.forEach(function(incident){
        table += '<tr>' +
                 '<td>' + incident.number + '</td>' +
                 '<td>' + incident.short_description + '</td>' +
                 '<td>' + incident.state + '</td>' +
                 '<td>' + incident.sys_updated_on + '</td>' +
                 '</tr>';
    });
    table += '</tbody></table>';
    document.getElementById('incidentTable').innerHTML = table;
});]]></script>
